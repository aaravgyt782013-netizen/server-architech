# Discord Developer Portal -> Application -> Bot
DISCORD_TOKEN=

# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=

# Your Discord server ID (enable Developer Mode, right-click server -> Copy Server ID)
GUILD_ID=

# Generate a long random secret. Use the same value in Render and the ChatGPT Action.
MANAGER_API_KEY=

# Optional: comma-separated Discord user IDs permitted to use Discord slash commands.
# The external API is protected separately by MANAGER_API_KEY.
MANAGER_DISCORD_USER_IDS=

# Service settings
PORT=10000
NODE_ENV=production
