# Discord Developer Portal -> Application -> Bot
DISCORD_TOKEN=

# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=

# Your Discord server ID
GUILD_ID=

# Generate a long random secret (at least 32 characters).
MANAGER_API_KEY=

# Dashboard login password. Use a different, strong password.
DASHBOARD_PASSWORD=

# Optional: separate random secret for signing browser sessions.
# If blank, MANAGER_API_KEY is used.
DASHBOARD_SESSION_SECRET=

# AI provider settings. The server uses an OpenAI-compatible Chat Completions API.
# Keep this key private; it is only used on the Render server, never sent to the browser.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.6-flash

# Optional: comma-separated Discord user IDs permitted to use the slash command.
MANAGER_DISCORD_USER_IDS=

PORT=10000
NODE_ENV=production
