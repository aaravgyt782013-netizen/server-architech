# Discord Developer Portal -> Application -> Bot
DISCORD_TOKEN=

# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=

# Your Discord server ID
GUILD_ID=

# Generate a long random secret (at least 32 characters).
MANAGER_API_KEY=

# Groq API settings. Uses Groq Chat Completions with vision + JSON mode.
# Keep this key private; it is only used on the Render server, never sent to the browser.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b

# Required: comma-separated Discord user IDs allowed to run /design.
MANAGER_DISCORD_USER_IDS=YOUR_DISCORD_USER_ID

PORT=10000
NODE_ENV=production
